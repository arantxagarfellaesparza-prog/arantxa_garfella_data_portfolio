# --- Local scratch, never published ---------------------------------------
# Career-planning notes, learning logs, and anything else meant for my eyes only.
.local/

# Belt and braces: learning notes are private by decision, so even one created
# outside .local/ by habit must not reach a public repository.
LEARNING_LOG.md
**/learning/

# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# --- Data ------------------------------------------------------------------
# Data is reproduced by scripts, not stored in Git. Git is bad at large binary
# blobs (every version is kept forever) and a public repo is the wrong place
# for a dataset whose licence I have not personally checked.
# `data/**` and not `data/`: excluding the directory itself makes Git skip it
# entirely, and a later negation can never re-include anything inside it.
data/**
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.db
*.duckdb
*.sqlite3
# Small, hand-written fixtures ARE tracked: tests need them to be deterministic,
# and each data/ folder keeps a README explaining how it is rebuilt.
!**/tests/fixtures/**
!data/README.md
# The checksum file is the pin. It is tiny, it is not data, and without it in
# Git there is nothing to verify a re-downloaded snapshot against.
!data/**/*.sha256

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints/
# Note: outputs are stripped by the nbstripout pre-commit hook, not ignored,
# so the .ipynb source itself stays reviewable in a diff.

# --- Models / experiment tracking -----------------------------------------
mlruns/
mlartifacts/
models/*.pkl
models/*.joblib
models/*.onnx
*.h5

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# --- OS / editor -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
